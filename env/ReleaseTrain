version: '3'
name: release_train
services:
    view:
        image: 169.254.149.20:6001/release_view:v2.29.2
        environment:
            PORT: 5000
            ADMIN_HELPDESK: /var/admin_helpdesk
        ports:
            - 8080:5000
        volumes:
            - "shared:/var/shared"
            - "shared_ready:/var/shared/ready"
            - "shared_todo:/var/shared/todo"
            - "tmp_view:/tmp"
            - "messages:/var/admin_helpdesk"
    worker:
        image: 169.254.149.20:6001/caelum_release_work:v1.27.2
        volumes:
            - "shared:/var/shared"
            - "shared_ready:/var/shared/ready"
            - "shared_todo:/var/shared/todo"
            - "tmp_worker:/tmp"
            - "cached:/var/cached"
    admin_helpdesk:
        image: 169.254.149.20:6001/caelum_admin_helpdesk_release:0.3.2
        environment:
            ADMIN_HELPDESK: /var/admin_helpdesk
        ports:
            - 8101:5000
        volumes:
            - "messages:/var/admin_helpdesk"
    qcon:
        image: 169.254.149.20:6001/caelum_qcon_dev:2.27.2
        ports:
            - 8100:8100
        volumes:
            - "cached:/var/cached"
volumes:
    cached:
    messages:
    shared:
    shared_ready:
    shared_todo:
    tmp_view:
    tmp_worker:
